# Copy to .env.local and fill in. Never commit real values.
# Local Supabase values come from `pnpm supabase status -o env` (or `pnpm db:env`, if available):
#   API_URL -> NEXT_PUBLIC_SUPABASE_URL, PUBLISHABLE_KEY -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#   SECRET_KEY -> SUPABASE_SECRET_KEY.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, sb_publishable_... (public, safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, sb_secret_... (server-only; used in /api/cron/* only, never anywhere else)
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile site key (public). Leave empty locally: the widget then does not render and
# no captcha token is sent (captcha is enforced in the production Supabase dashboard).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Show "Continue with Google" on /login. Leave unset until owner action O3 enables Google in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# Shared secret that protects /api/cron/* routes (server-only)
CRON_SECRET=
