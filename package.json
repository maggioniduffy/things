{
  "name": "things",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io pnpm supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor,realtime,postgres-meta",
    "db:stop": "pnpm supabase stop",
    "db:reset": "pnpm supabase db reset",
    "db:test": "pnpm supabase test db",
    "db:lint": "pnpm supabase db lint --level warning",
    "db:types": "pnpm supabase gen types typescript --local > src/types/database.types.ts && prettier --write src/types/database.types.ts",
    "db:env": "node scripts/write-env-local.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "~6.3.1",
    "@dnd-kit/sortable": "~10.0.0",
    "@dnd-kit/utilities": "~3.2.2",
    "@marsidev/react-turnstile": "1.6.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "~5.104.2",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "~12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "fractional-indexing": "~4.0.0",
    "ipaddr.js": "~2.5.0",
    "linkedom": "~0.18.13",
    "lucide-react": "^1.55.0",
    "motion": "~14.1.0",
    "next": "16.4.3",
    "pdfjs-dist": "~6.4.299",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tus-js-client": "~4.3.1",
    "tw-animate-css": "^1.4.0",
    "undici": "8.11.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "~5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "2.120.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "~4.1.11"
  }
}
